msgstr "百叶窗效果"

#: prefs.js:284
msgid "Enable Window Close Effect"
msgstr "启用窗口关闭效果"

#: prefs.js:285
msgid "When enabled, play animation effect when closing window"
msgstr "启用后，关闭窗口时播放动画效果"

#: prefs.js:291
msgid "Window Close Effect Type"
msgstr "窗口关闭效果类型"

#: prefs.js:292
msgid "Select window close animation effect"
msgstr "选择窗口关闭动画效果"

#: prefs.js:335
msgid "Enable Window Minimize Effect"
msgstr "启用窗口最小化效果"

