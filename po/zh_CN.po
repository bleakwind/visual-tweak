msgid "Window Unminimize Effect Type"
msgstr "窗口还原效果类型"

#: prefs.js:310
msgid "Select window unminimize animation effect"
msgstr "选择窗口还原动画效果"

#: prefs.js:349
msgid "Window"
msgstr "窗口"

#: prefs.js:355 prefs.js:467
msgid "Dock"
msgstr "Dock"

#: prefs.js:356
msgid "A bottom dock that appears when the pointer touches the bottom edge"
msgstr "一个在指针触碰屏幕底边时出现的 Dock"

#: prefs.js:360
msgid "Enable Dock"
msgstr "打开Dock"

#: prefs.js:361
msgid "When enabled, show a dock at the bottom of the screen that appears when the pointer touches the bottom edge"
msgstr "启用后，当指针触碰屏幕底边时，屏幕底部会显示一个 Dock"

#: prefs.js:368
msgid "Dock Icon Size"
msgstr "Dock图标尺寸"

#: prefs.js:369
msgid "Size of the dock icons in pixels"
msgstr "Dock图标按像素尺寸"

#: prefs.js:443
msgid "Dock Background Color"
msgstr "Dock背景颜色"

#: prefs.js:444
msgid "Dock background color in hexadecimal format, e.g. #000000 or #1c1c1c"
msgstr "Dock背景颜色，十六进制格式，例如 #000000 或 #1c1c1c"

#: prefs.js:451
msgid "Dock Background Opacity"
msgstr "Dock背景透明度"

#: prefs.js:452
msgid "Opacity of the dock background, 0 = fully transparent, 100 = fully opaque"
msgstr "Dock背景的透明度，0 = 全透明，100 = 完全不透明"

#: prefs.js:473 prefs.js:485
msgid "Clock Format"
msgstr "时钟定制"

#: prefs.js:474
msgid "Customize the format of the panel clock"
msgstr "定制顶部面板时钟"

#: prefs.js:478
msgid "Enable Clock Format"
msgstr "打开时钟定制"

#: prefs.js:479
msgid "When enabled, the panel clock uses the custom format specified"
msgstr "启用后，面板时钟将使用指定的自定义格式"

#: prefs.js:486
msgid "Custom clock format using strftime-style specifiers, e.g. %Y-%m-%d %H:%M or %H:%M:%S"
msgstr "使用 strftime 风格格式符的自定义时钟格式，例如 %Y-%m-%d %H:%M 或 %H:%M:%S"

