#: prefs.js:32 prefs.js:137 prefs.js:645
msgid "Visual Tweak"
msgstr "Visual Tweak"

#: prefs.js:153
msgid "Panel Beautify"
msgstr "面板美化"

#: prefs.js:154
msgid "Control whether the panel beautification is enabled"
msgstr "控制是否启用面板美化"

#: prefs.js:158
msgid "Enable Panel Beautify"
msgstr "启用面板美化"

#: prefs.js:159
msgid "When enabled, the panel applies beautification effects"
msgstr "开启后，面板会应用美化效果"

#: prefs.js:167
msgid "Panel Background Opacity"
msgstr "面板背景透明度"

#: prefs.js:168
msgid "Opacity of the panel background, 0 = fully transparent, 100 = fully opaque"
msgstr "面板背景的透明度，0 = 全透明，100 = 完全不透明"

#: prefs.js:178
msgid "Custom Background Color"
msgstr "自定义背景颜色"

#: prefs.js:179
msgid "When enabled, the panel background uses the color specified below"
msgstr "开启后，面板背景使用下方指定的颜色"

#: prefs.js:187
msgid "Background Color"
msgstr "背景颜色值"

#: prefs.js:188
msgid "Panel background color in hexadecimal format, e.g. #000000 or #1c1c1c"
msgstr "面板背景颜色，十六进制格式，例如 #000000 或 #1c1c1c"

#: prefs.js:199
msgid "Custom Text Color"
msgstr "自定义文字颜色"

#: prefs.js:200
msgid "When enabled, the panel text uses the color specified below"
msgstr "开启后，面板文字使用下方指定的颜色"

#: prefs.js:208
msgid "Text Color"
msgstr "文字颜色值"

#: prefs.js:209
msgid "Panel text color in hexadecimal format, e.g. #ffffff or #ececec"
msgstr "面板文字颜色，十六进制格式，例如 #ffffff 或 #ececec"

#: prefs.js:221
msgid "Panel"
msgstr "面板"

#: prefs.js:228
msgid "Window Effects"
msgstr "窗口效果"

#: prefs.js:229
msgid "Control window display effects"
msgstr "控制窗口显示效果"

#: prefs.js:233
msgid "Enable Window Open Effect"
msgstr "启用窗口打开效果"

#: prefs.js:234
msgid "When enabled, play animation effect when opening window"
msgstr "启用后，打开窗口时播放动画效果"

#: prefs.js:240
msgid "Window Open Effect Type"
msgstr "窗口打开效果类型"

#: prefs.js:241
msgid "Select window open animation effect"
msgstr "选择窗口打开动画效果"

#: prefs.js:244 prefs.js:247 prefs.js:295 prefs.js:298
msgid "TV Effect"
msgstr "电视效果"

