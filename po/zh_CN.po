#: prefs.js:13 prefs.js:105 prefs.js:390
msgid "Visual Tweak"
msgstr "Visual Tweak"

#: prefs.js:121
msgid "Panel Beautify"
msgstr "面板美化"

#: prefs.js:122
msgid "Control whether the panel beautification is enabled"
msgstr "控制是否启用面板美化"

#: prefs.js:126
msgid "Enable Panel Beautify"
msgstr "启用面板美化"

#: prefs.js:127
msgid "When enabled, the panel applies beautification effects"
msgstr "开启后，面板会应用美化效果"

#: prefs.js:135
msgid "Panel Background Opacity"
msgstr "面板背景透明度"

#: prefs.js:136
msgid ""
"Opacity of the panel background, 0 = fully transparent, 100 = fully opaque"
msgstr "面板背景的透明度，0 = 全透明，100 = 完全不透明"

#: prefs.js:146
msgid "Custom Background Color"
msgstr "自定义背景颜色"

#: prefs.js:147
msgid "When enabled, the panel background uses the color specified below"
msgstr "开启后，面板背景使用下方指定的颜色"

#: prefs.js:155
msgid "Background Color"
msgstr "背景颜色值"

#: prefs.js:156
msgid "Panel background color in hexadecimal format, e.g. #000000 or #1c1c1c"
msgstr "面板背景颜色，十六进制格式，例如 #000000 或 #1c1c1c"

#: prefs.js:167
msgid "Custom Text Color"
msgstr "自定义文字颜色"

#: prefs.js:168
msgid "When enabled, the panel text uses the color specified below"
msgstr "开启后，面板文字使用下方指定的颜色"

#: prefs.js:176
msgid "Text Color"
msgstr "文字颜色值"

#: prefs.js:177
msgid "Panel text color in hexadecimal format, e.g. #ffffff or #ececec"
msgstr "面板文字颜色，十六进制格式，例如 #ffffff 或 #ececec"

#: prefs.js:189
msgid "Panel"
msgstr "面板"

#: prefs.js:196 prefs.js:208
msgid "Clock Format"
msgstr "时钟定制"

#: prefs.js:197
msgid "Customize the format of the panel clock"
msgstr "定制顶部面板时钟"

#: prefs.js:201
msgid "Enable Clock Format"
msgstr "打开时钟定制"

#: prefs.js:202
msgid "When enabled, the panel clock uses the custom format specified"
msgstr "启用后，面板时钟将使用指定的自定义格式"

#: prefs.js:209
msgid ""
"Custom clock format using strftime-style specifiers, e.g. %Y-%m-%d %H:%M:%S "
"or %H:%M"
msgstr "使用 strftime 风格格式符的自定义时钟格式，例如 %Y-%m-%d %H:%M:%S 或 %H:%M"

