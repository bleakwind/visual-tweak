msgid "When enabled, play animation effect when minimizing window"
msgstr "启用后，最小化窗口时播放动画效果"

#: prefs.js:342
msgid "Window Minimize Effect Type"
msgstr "窗口最小化效果类型"

#: prefs.js:343
msgid "Select window minimize animation effect"
msgstr "选择窗口最小化动画效果"

#: prefs.js:346 prefs.js:349 prefs.js:397 prefs.js:400
msgid "Genie Effect"
msgstr "神灯效果"

#: prefs.js:347 prefs.js:350 prefs.js:398 prefs.js:401
msgid "Scale Effect"
msgstr "缩放效果"

#: prefs.js:386
msgid "Enable Window Unminimize Effect"
msgstr "启用窗口还原效果"

#: prefs.js:387
msgid "When enabled, play animation effect when restoring window"
msgstr "启用后，还原窗口时播放动画效果"

#: prefs.js:393
msgid "Window Unminimize Effect Type"
msgstr "窗口还原效果类型"

#: prefs.js:394
msgid "Select window unminimize animation effect"
msgstr "选择窗口还原动画效果"

#: prefs.js:437
msgid "Window"
msgstr "窗口"

#: prefs.js:444 prefs.js:456
msgid "Clock Format"
msgstr "时钟定制"

#: prefs.js:445
msgid "Customize the format of the panel clock"
msgstr "定制顶部面板时钟"

#: prefs.js:449
msgid "Enable Clock Format"
msgstr "打开时钟定制"

#: prefs.js:450
msgid "When enabled, the panel clock uses the custom format specified"
msgstr "启用后，面板时钟将使用指定的自定义格式"

#: prefs.js:457
msgid "Custom clock format using strftime-style specifiers, e.g. %Y-%m-%d %H:%M or %H:%M:%S"
msgstr "使用 strftime 风格格式符的自定义时钟格式，例如 %Y-%m-%d %H:%M 或 %H:%M:%S"

